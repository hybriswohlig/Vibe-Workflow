FAL_KEY=your_fal_key_here
PUBLIC_API_BASE_URL=http://localhost:8000

# Optional command fallbacks for subscription-backed OpenAI/Grok media generation.
# Commands receive JSON ({"model","params"}) on stdin and write JSON ({"images":[{"url"}]}) to stdout.
# For gpt-image-* via a logged-in Codex (ChatGPT) subscription, point this at the bundled bridge:
#   OPENAI_MEDIA_COMMAND=/abs/path/to/server/scripts/codex_media.py   (requires `codex login`, uses ~/.codex)
# For grok-imagine-* (image+video) via a logged-in Grok Build session (or XAI_API_KEY):
#   GROK_MEDIA_COMMAND=/abs/path/to/server/scripts/grok_media.py      (requires `grok login`, uses ~/.grok)
# Both use the subscription token; no paid API key needed.
OPENAI_MEDIA_COMMAND=
GROK_MEDIA_COMMAND=

# Optional assistant command for workflow planning/editing.
# Reads JSON on stdin. Writes JSON: {"message": "...", "suggestions": [], "workflow": null}
WORKFLOW_ASSISTANT_URL=http://127.0.0.1:8787/workflow-assistant
WORKFLOW_ASSISTANT_COMMAND=/Users/dariushk/Documents/GitHub/Vibe-Workflow/server/scripts/workflow_assistant.py
WORKFLOW_ASSISTANT_BACKENDS=codex
